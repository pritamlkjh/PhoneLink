<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8F9FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- App Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginBottom="20dp"
            android:paddingTop="12dp">

            <TextView
                android:id="@+id/tvAppTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PhoneLink"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#1E88E5" />

            <TextView
                android:id="@+id/tvAppSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Authorized Personal Remote Access"
                android:textSize="14sp"
                android:textColor="#5F6368"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tvDeviceId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Device ID: loading..."
                android:textSize="12sp"
                android:textColor="#757575"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- Connection & Pairing Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeWidth="1dp"
            app:strokeColor="#E0E0E0">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Connection &amp; Pairing"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#212121"
                    android:layout_marginBottom="12dp" />

                <!-- Status Banner -->
                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Status: Disconnected"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#D32F2F"
                    android:background="#FFEBEE"
                    android:padding="10dp"
                    android:layout_marginBottom="14dp" />

                <!-- Relay URL Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilRelayUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="VPS Relay Server URL"
                    android:layout_marginBottom="10dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etRelayUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:fontFamily="monospace"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Pairing Code Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPairingCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="8-Character Pairing Code (from Mac 'phonelink pair')"
                    android:layout_marginBottom="14dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPairingCode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapCharacters"
                        android:fontFamily="monospace"
                        android:textSize="16sp"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Action Buttons -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConnectPair"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Connect &amp; Pair"
                    android:textSize="15sp"
                    android:textAllCaps="false"
                    app:cornerRadius="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUnpair"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Unpair &amp; Disconnect"
                    android:textSize="14sp"
                    android:textAllCaps="false"
                    android:layout_marginTop="8dp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    app:cornerRadius="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Permissions & Security Controls Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeWidth="1dp"
            app:strokeColor="#E0E0E0">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Security &amp; Permissions"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#212121"
                    android:layout_marginBottom="12dp" />

                <!-- Remote Camera Toggle -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchCamera"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Allow Remote Camera Access"
                    android:textSize="14sp"
                    android:textColor="#212121"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Off by default. When enabled, your paired Mac can stream camera."
                    android:textSize="12sp"
                    android:textColor="#757575"
                    android:layout_marginBottom="12dp" />

                <!-- Boot Auto-Start Toggle -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchBoot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Auto-Start on Boot"
                    android:textSize="14sp"
                    android:textColor="#212121"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Automatically reconnects background service when phone starts."
                    android:textSize="12sp"
                    android:textColor="#757575"
                    android:layout_marginBottom="16dp" />

                <!-- System Permission Helper Buttons -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPermNotification"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Grant Notification Permission"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    style="@style/Widget.MaterialComponents.Button.TextButton" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPermCamera"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Grant Camera Permission"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    style="@style/Widget.MaterialComponents.Button.TextButton" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPermBattery"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Disable Battery Optimization (Recommended)"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    style="@style/Widget.MaterialComponents.Button.TextButton" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSelectFolder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Select Shared Folder (Default: App Files)"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    style="@style/Widget.MaterialComponents.Button.TextButton" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Quick Info / Privacy Guarantee -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="End-to-End Encrypted (ECDH + AES-256-GCM) • Zero VPS Plaintext • Foreground Notification Guaranteed"
            android:textSize="11sp"
            android:textColor="#9E9E9E"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
