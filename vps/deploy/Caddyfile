{
    # Global options
    admin off
    log {
        output file /var/log/caddy/phonelink_caddy.log {
            roll_size 10MiB
            roll_keep 5
        }
        format json
    }
}

# Replace example domain with a real DNS-routed public domain (e.g. relay.yourdomain.com)
# for automatic ACME TLS; `.local` domains cannot obtain public Let's Encrypt/ZeroSSL certs.
{$PHONELINK_DOMAIN:relay.example.com} {
    # Strict TLS Configuration (Let's Encrypt / ZeroSSL automatic TLS)
    tls {$PHONELINK_TLS_EMAIL:admin@example.com}

    # Security Headers (API routes enforce default-src 'none'; /install permits inline CSS/data images)
    @installPage {
        path /install /install/
    }
    @apiRoutes {
        not path /install /install/
    }
    header {
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
    }
    header @installPage Content-Security-Policy "default-src 'self'; style-src 'unsafe-inline'; img-src 'self' data:; frame-ancestors 'none';"
    header @apiRoutes Content-Security-Policy "default-src 'none'; frame-ancestors 'none';"

    # Logging
    log {
        output file /var/log/caddy/phonelink_access.log {
            roll_size 20MiB
            roll_keep 7
        }
        format json
    }

    # Health check passthrough (public probe)
    handle /healthz {
        reverse_proxy 127.0.0.1:8443
    }

    # Rate limiting on authentication challenge/verify endpoints (protect against brute-force)
    @authEndpoints {
        path /api/v1/auth/*
    }
    handle @authEndpoints {
        reverse_proxy 127.0.0.1:8443
    }

    # WebSocket connection endpoint
    @websocket {
        header Connection *Upgrade*
        header Upgrade websocket
    }
    handle @websocket {
        reverse_proxy 127.0.0.1:8443
    }

    # All other API routes
    handle {
        reverse_proxy 127.0.0.1:8443
    }
}
